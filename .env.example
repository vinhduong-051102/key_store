# Sinh bằng: docker compose run --rm keyvault python -m app.manage gen-secrets
KV_MASTER_KEY=
KV_SESSION_SECRET=
# KV_COOKIE_SECURE=true          # đặt false CHỈ khi thử nghiệm qua http://localhost
# KV_EXPORT_TTL=300              # giây, thời hạn để nhập OTP sau khi export
# KV_EXPORT_MAX_ATTEMPTS=3       # số lần sai OTP trên một export trước khi hủy
# KV_MAX_OTP_FAILURES=5          # số lần sai OTP liên tiếp trước khi khóa tạm
# KV_LOCKOUT_SECONDS=900
# KV_DISPLAY_TZ=Asia/Ho_Chi_Minh
# DATABASE_URL=postgresql+psycopg://user:pass@db:5432/keyvault
